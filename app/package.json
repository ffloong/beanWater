{
  "name": "beanwater-app",
  "version": "1.0.0",
  "private": true,
  "description": "BeanWater 破壁机食谱助手",
  "template": "default",
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "build:h5": "taro build --type h5",
    "dev:h5": "npm run build:h5 -- --watch",
    "typecheck": "tsc --noEmit",
    "check:data": "node scripts/check-data.mjs"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 61",
    "ios >= 9"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@tarojs/components": "4.3.3",
    "@tarojs/helper": "4.3.3",
    "@tarojs/plugin-framework-react": "4.3.3",
    "@tarojs/plugin-platform-h5": "4.3.3",
    "@tarojs/plugin-platform-weapp": "4.3.3",
    "@tarojs/react": "4.3.3",
    "@tarojs/runtime": "4.3.3",
    "@tarojs/shared": "4.3.3",
    "@tarojs/taro": "4.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@tarojs/cli": "4.3.3",
    "@tarojs/webpack5-runner": "4.3.3",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/webpack-env": "^1.18.4",
    "babel-preset-taro": "4.3.3",
    "typescript": "^5.5.4",
    "vitest": "^3.2.7",
    "webpack": "5.91.0"
  }
}
